# Jangan commit .env. Semua di Base Sepolia (84532).
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
ACP_ADDRESS=0x0b93793923CD5De81850aF8604a233f3f24d461e
# AWAS: ADA DUA token di Base Sepolia yang sama-sama menjawab symbol() = "USDC".
# Escrow ACP menarik token DI BAWAH INI, BUKAN USDC Circle. Dibuktikan on-chain:
#   cast call $ACP_ADDRESS "paymentToken()(address)" --rpc-url $RPC_URL
# Karena symbol() keduanya identik, JANGAN pernah memverifikasi token ini dengan symbol();
# verifikasi HANYA lewat paymentToken(). decimals() JUGA identik (6 vs 6), jadi itu pun bukan
# pembeda; name() berbeda ("USDC" vs "USD Coin") tetapi lemah dan tidak mengikat kontrak ACP.
# Token escrow ini juga punya mint() tanpa kontrol akses.
USDC_ADDRESS=0xECc22a8F6fD62388498fBa19813E214605a2BDb3
# USDC Circle (0x036CbD53842c5426634e7929541eC2318f3dCF7e) TIDAK dipakai escrow ACP.
# Memakainya membuat fund() menarik token yang salah dan menggagalkan alur job.
VAULT_ADDRESS=0x5c6EE4586ACABcb6326069c229E58091B21ef384   # deployed 2026-09-03, blok 46350667
AGENT_PRIVATE_KEY=        # wallet agen (onlyAgent di vault) — testnet saja; alamat: 0xfa5AF5BAeB4aC500267D7189fa1f0AA923eCA894
CLIENT_ADDRESS=           # wallet client simulator — PEMEGANG token escrow yang di-fund ke ACP.
                          # BUKAN wallet evaluator: AGENT_PRIVATE_KEY di atas hanya perlu ETH untuk
                          # GAS; saldo token-nya boleh nol selamanya.
                          # JANGAN memanggil deposit() selama ADR-013 berlaku. Itu satu-satunya pintu
                          # ETH MASUK ke vault dan TIDAK ADA pintu keluar (resolve() masih stub, tidak
                          # ada withdraw), jadi ETH yang disetor terkunci PERMANEN. MIN_BOND = 0 di
                          # vault yang terdeploy, jadi postVerdict tidak membutuhkan bond sama sekali.
CLIENT_PRIVATE_KEY=       # wallet client simulator (ADR-017) — testnet saja; alamat:
                          # 0xbe2c447e577F95ed2D5cD20C75cF7633FA0602C2
                          # Dipakai sim/client_min.ts untuk createJob + fund SAJA. setBudget & submit
                          # ditandatangani PROVIDER_PRIVATE_KEY di bawah — client dan provider TIDAK
                          # BOLEH satu alamat (ClientIsProvider() 0x332ff0f9). Evaluator TIDAK PERNAH
                          # memakai kunci ini: yang wajib independen adalah wasitnya.
                          # Didanai 0,002 ETH dari wallet agen + 2 USDC lewat mint() token escrow yang
                          # TANPA kontrol akses. Untuk skenario 3.1 (3 job) saldo ini KURANG — top-up
                          # 100 USDC masih milik task 0.4b.
PROVIDER_PRIVATE_KEY=     # wallet provider simulator (ADR-017) — testnet saja; alamat:
                          # 0x20212E4D95A75E6716575ED26e884cdeFf66b321
                          # Menandatangani setBudget + submit (keduanya provider-only di ACP).
                          # WAJIB alamat ketiga yang terpisah, bukan gaya: createJob merevert
                          # ClientIsProvider() 0x332ff0f9 bila msg.sender == provider, dan
                          # EvaluatorIsProvider() 0xc7b4e9eb bila evaluator == provider.
                          # ETH saja, TANPA token: provider MENERIMA pembayaran, tidak membayar.
                          # Wallet agen DILARANG merangkap peran ini (ADR-017 poin 3).
# PERINGATAN: vault v1 YANG SEKARANG TERDEPLOY memakai arbiter YANG SAMA dengan agent
# (on-chain arbiter() == agent() == 0xfa5AF5BAeB4aC500267D7189fa1f0AA923eCA894).
# Itu aman HANYA selama vault tidak punya sweepToken: v1 memang tidak punya (dibuktikan —
# cast call ke selectornya `execution reverted`). Sejak sweepToken ada di kode, arbiter menjadi
# pemegang TUNGGAL seluruh saldo ERC-20 vault, tanpa timelock/two-step/allowlist penerima.
# Karena itu REDEPLOY WAJIB memakai arbiter di bawah, dan ALLOW_ARBITER_EQ_AGENT WAJIB kosong.
ARBITER_ADDRESS=0xC9CF30c8aB471fD22536B955b5CFb79D26672cF1
ARBITER_PRIVATE_KEY=      # wallet arbiter (ADR-018) — testnet saja; alamat ARBITER_ADDRESS di atas.
                          # Memegang sweepToken(onlyArbiter) pada vault hasil redeploy. ETH saja
                          # (hanya perlu gas); resolve() masih stub ADR-013, jadi belum ada wewenang
                          # lain. WAJIB berbeda dari agent, client, dan provider.

# --- dibaca script/Deploy.s.sol (ADR-016) ---
# AGENT_ADDRESS: WAJIB di-set. Skrip deploy menolak bila alamat ini tidak sama dengan alamat yang
# diturunkan dari kunci penanda tangan. Bila DIBIARKAN KOSONG, guard itu berubah jadi TAUTOLOGI
# (defaultnya alamat deployer sendiri, jadi cek selalu lolos) dan salah-kunci tidak akan ketahuan
# sampai vault terdeploy dengan `agent` immutable yang salah — tidak bisa diperbaiki tanpa redeploy.
AGENT_ADDRESS=0xfa5AF5BAeB4aC500267D7189fa1f0AA923eCA894
#
# ALLOW_ARBITER_EQ_AGENT: SEKALI-PAKAI. Skrip deploy menolak `arbiter == agent` kecuali ini `true`.
# HAPUS dari .env SEGERA sesudah deploy: nilainya tertanam IMMUTABLE di vault, sementara variabel ini
# lengket di .env tanpa kedaluwarsa, jadi deploy berikutnya akan diam-diam melewati guard yang sama.
# BIARKAN KOSONG untuk redeploy berikutnya. Sejak sweepToken(onlyArbiter) ada, mengisinya `true`
# berarti evaluator yang mengumumkan verdict adalah pihak yang menyapu fee 5% dari verdict itu
# sendiri (temuan SEDANG @agent-security-reviewer 4 Sep). ARBITER_ADDRESS di atas sudah terpisah,
# jadi tidak ada alasan sah untuk mengisinya lagi.
ALLOW_ARBITER_EQ_AGENT=
#
# CHAIN_ID dibaca juga oleh skrip deploy sebagai guard: deploy menolak bila `block.chainid` dari
# --rpc-url tidak sama dengan nilai di atas (mencegah RPC salah ketik men-deploy ke jaringan lain).
#
# JANGAN pernah menambahkan --json pada perintah deploy: forge mendump calldata cheatcode MENTAH
# tanpa sensor dan kunci privat tercetak utuh. Alamat vault: `make deploy-address`.

SIBYL_DB_PATH=./data/memory.db
# DELIVERABLE_DIR: artefak deliverable yang dibaca cek deterministik (ADR-019 keputusan 1),
# yaitu `<jobId>.json` berisi teks + `sha_keccak`-nya. Default `demo/deliverables` relatif
# AKAR REPO, bukan direktori kerja. Mengarahkannya ke direktori lain berarti job dinilai dari
# teks lain; hash on-chain `JobSubmitted` tetap yang memutuskan teks itu sah atau tidak.
DELIVERABLE_DIR=demo/deliverables
# VERDICT_BUNDLE_DIR: toko bukti verdict — JSON kanonik yang di-keccak menjadi `reasonHash`
# on-chain (`<jobId>-0x<reasonHash>.json`, sekali-tulis). Default: `verdicts/` DI SAMPING
# SIBYL_DB_PATH. Kosongkan kecuali benar-benar perlu: satu variabel ini memindahkan TULIS dan
# BACA sekaligus, dan menjalankan agen dengan nilai berbeda dari run yang mengumumkan verdict
# membuat preimage `reasonHash` tidak ketemu — agen menolak finalize bukti yang tidak bisa
# ditunjukkan. Isinya bukan rahasia (hasil cek + angka cap + jobId), tetapi ia satu-satunya
# salinan preimage: backup bersama memory.db, dan JANGAN pernah dihapus untuk job yang
# verdictnya sudah diumumkan.
VERDICT_BUNDLE_DIR=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
DEMO_MODE=true            # mengizinkan tombol hapus memori & header pembayaran dummy (402 buatan sendiri, ADR-010 — BUKAN x402)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_AGENT_API=http://localhost:8000

# --- gerbang 402 POST /jobs/register (agent/agent/payment_402.py, ADR-010) ---
# Semua berdefault aman; kosongkan untuk memakai default.
PAYMENT_RATE_LIMIT=            # maks permintaan per jendela per klien (default 30; <=0 mematikan rate limit)
PAYMENT_RATE_WINDOW_SECONDS=   # panjang jendela rate limit dalam detik (default 60)
PAYMENT_MIN_BLOCK=             # lantai blok: transfer di bawah nomor ini ditolak `transfer_too_old`
                               # (default 0 = mati; selama mati, transfer LAMA ke payTo tetap berlaku sebagai kredensial)
